# Runtime
ENVIRONMENT=production
HOST=127.0.0.1
PORT=8080
WEBAPP_URL=https://chat.example.com
INSTANCE_LOCK_FILE=/run/helper-bot/helper-bot.lock

# Existing Firestore project (do not create a new database)
DB_BACKEND=firebase
FIREBASE_CREDENTIALS=/etc/helper-bot/firebase-service-account.json
SESSION_CACHE_TTL=21600
USER_CACHE_TTL=21600
MESSAGE_LOAD_LIMIT=80

# Telegram and the existing model provider. Keep values only on the server.
BOT_TOKEN=
BOT_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://llm.alem.ai/v1
OPENAI_MODEL=gemma4
LLM_CONCURRENCY=4

# API guardrail. Browser polling uses about 24 requests/minute/user.
API_RATE_LIMIT=180
DEBUG_PROMPTS=false
